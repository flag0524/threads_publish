# --- 필수 (1차 MVP) ---
THREADS_APP_ID=
THREADS_APP_SECRET=

# --setup 실행할 때만 필요. Graph API 탐색기에서 발급한 단기 토큰.
# setup 성공 후 이 줄은 지우세요 (장기 토큰은 data/token.json에 저장됩니다).
THREADS_SHORT_LIVED_TOKEN=

# OAuth 인증 코드로 받을 때만 필요 (node index.js --setup --code <인증코드>).
# Meta 앱에 등록한 리디렉트 URI와 문자 그대로 같아야 합니다.
THREADS_REDIRECT_URI=

# --- 선택 (기본값 있음) ---
THREADS_API_VERSION=v1.0
POST_CRON=0 9 * * *
# 주 1회 생존 신호(기본 월요일 09:00). NOTIFY_WEBHOOK_URL이 있어야 실제로 나갑니다.
HEARTBEAT_CRON=0 9 * * 1
TZ=Asia/Seoul
MAX_POSTS_PER_DAY=1
REPLY_DELAY_MS=5000
PUBLISH_RETRY=3
TOKEN_REFRESH_BEFORE_DAYS=7
SOURCES=queue

# 쉼표로 구분. 본문/댓글에 포함되면 발행을 막습니다.
BANNED_WORDS=

# 발행 실패·토큰 만료 임박 알림을 받을 웹훅 URL (Slack / Discord / 카카오워크 등).
# 비워 두면 알림을 보내지 않습니다. 성공 알림은 보내지 않습니다.
NOTIFY_WEBHOOK_URL=

# 발행 계정 안전장치. 토큰의 계정이 이 값과 다르면 발행을 거부합니다.
# 비워 두면 검사하지 않습니다. 다른 계정에 잘못 올리는 사고를 막아줍니다.
EXPECTED_THREADS_USERNAME=flag_21

# --- 2차 (LLM 소스) ---
# ANTHROPIC_API_KEY=
# LLM_MODEL=
# AUTO_APPROVE=false

# --- 3차 (RSS 소스) ---
# NAVER_BLOG_ID=
# RSS_POLL_CRON=0 * * * *
